{
  "name": "@signal-app/velocity-editor",
  "version": "0.1.0",
  "description": "Editor facade for the note velocity lane",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts",
      "types": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@signal-app/core": "workspace:*",
    "@signal-app/observable": "workspace:*"
  }
}
