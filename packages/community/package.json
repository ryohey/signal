{
  "name": "@signal-app/community",
  "private": true,
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm run copy-assets && tsc",
    "copy-assets": "copyfiles -u 1 src/**/*.svg dist/",
    "dev": "pnpm run build --watch",
    "test": "vitest run",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write"
  },
  "author": "ryohey",
  "license": "MIT",
  "devDependencies": {
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "copyfiles": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-portal": "catalog:",
    "@ryohey/react-svg-spinners": "catalog:",
    "@signal-app/api": "workspace:*",
    "@signal-app/firebaseui-web-react": "workspace:*",
    "@signal-app/player": "workspace:*",
    "color": "catalog:",
    "dialog-hooks": "workspace:*",
    "firebase": "catalog:",
    "lodash": "catalog:",
    "mdi-react": "catalog:",
    "midifile-ts": "catalog:",
    "mobx": "catalog:",
    "mobx-react-lite": "catalog:",
